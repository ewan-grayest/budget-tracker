# Copy to .env and edit. Every value here is a default that docker-compose.yml
# already applies, so an empty .env behaves exactly like no .env at all.
# Leaving a variable blank means "unset" — the application falls back to its
# own default rather than treating it as an empty string.

# --- Application ------------------------------------------------------------
# Display name in the UI.
APP_NAME=Budget Control
# Directory holding every persistent file the app owns. Mount this path.
DATA_DIR=/data
# SQLite location. Blank derives it as $DATA_DIR/budget.db.
DB_PATH=
# Seconds SQLite waits on a locked database before giving up.
DB_TIMEOUT=30
# Permissions applied to the database files at startup. Group write matters on
# hosts that assign a different uid on each start but keep the gid.
DATA_FILE_MODE=0660
# Interface the server binds inside the container. Leave 0.0.0.0 so the
# container's own network namespace is reachable.
HOST=0.0.0.0
# Port inside the container. Hosting platforms that inject PORT override this.
PORT=8080
# Create demo records in an empty database. Set 0 for production.
SEED_DEMO=1
# UI language when the visitor has no preference: en or ru.
DEFAULT_LANG=en

# --- Authentication ---------------------------------------------------------
# Both must be set to enable HTTP Basic Authentication. /healthz stays open so
# container healthchecks keep working.
APP_USER=
APP_PASSWORD=

# --- Cookies behind a proxy -------------------------------------------------
# auto marks cookies Secure only when the forwarded-scheme header says https.
# Force with 1 or 0 when the proxy does not send that header.
COOKIE_SECURE=auto
# Blank disables the lookup entirely — use that when nothing in front of the
# app can be trusted to set the header.
FORWARDED_PROTO_HEADER=X-Forwarded-Proto

# --- Exchange rates ---------------------------------------------------------
# Blank uses the built-in CBR endpoint.
CBR_URL=
CBR_TIMEOUT=10

# --- Container runtime ------------------------------------------------------
PYTHON_IMAGE=python:3.12-slim
IMAGE_NAME=budget-manager
IMAGE_TAG=local
CONTAINER_NAME=budget-manager
RESTART_POLICY=unless-stopped
VOLUME_NAME=budget_data
# Identity baked into the image and used by the entrypoint.
APP_UID=10001
APP_GID=0
# Account the container starts as. Set 0:0 on hosts that attach a root-owned
# volume; the entrypoint chowns DATA_DIR and drops back to APP_UID:APP_GID.
# That also requires uncommenting the cap_add block in docker-compose.yml.
CONTAINER_USER=10001:0
# Creation mask for new files. 0002 keeps them group-writable so a host that
# assigns a different uid on restart can still write the database.
UMASK=0002
# Account the entrypoint hands DATA_DIR to and drops privileges to.
RUN_UID=10001
RUN_GID=0
# Take ownership of DATA_DIR when the container starts as root. Set 0 if the
# platform already manages the mount's ownership.
CHOWN_DATA_DIR=1
# Keep the application running as root instead of dropping privileges. Only for
# platforms that cannot work any other way.
ALLOW_ROOT=0

# --- Publishing -------------------------------------------------------------
# Host interface the port is published on. 0.0.0.0 exposes the service beyond
# this machine — only do that behind a TLS-terminating reverse proxy.
BIND_ADDRESS=127.0.0.1
HOST_PORT=8080

# --- Limits and logging -----------------------------------------------------
READ_ONLY_ROOT=true
MEM_LIMIT=256m
CPU_LIMIT=1.0
LOG_DRIVER=json-file
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=3s
HEALTHCHECK_START_PERIOD=5s
HEALTHCHECK_RETRIES=3
